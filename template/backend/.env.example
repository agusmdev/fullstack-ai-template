# Backend configuration for running OUTSIDE Docker (uv run ...).
# Copy to .env: cp .env.example .env
# Inside Docker Compose these values come from the root .env instead.

# Use localhost here: outside Compose there is no `db` hostname.
DB_URL=postgresql://app:app@localhost:5432/app
DB_POOL_SIZE=100
DB_POOL_PRE_PING=false

APP_NAME=backend
ENVIRONMENT=local
DEBUG_MODE=false

LOG_LEVEL=INFO
LOG_FORMAT=console

FRONTEND_URL=http://localhost:3000

# Optional integrations — leave empty to disable.
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
