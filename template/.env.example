# Docker Compose configuration.
# Copy to .env for local overrides (git-ignored): cp .env.example .env
# Every value below already has a working default in docker-compose.yml.
# Keep values free of inline comments — Compose reads them literally.

# --- Service ports (change if they clash with something already running) ---
BACKEND_PORT=9095
FRONTEND_PORT=3000
DB_PORT=5432

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Host `db` is the Compose service name, reachable from the backend container.
DB_URL=postgresql://app:app@db:5432/app

# --- Backend runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO
# CORS origin the backend accepts — keep in sync with FRONTEND_PORT.
FRONTEND_URL=http://localhost:3000

# --- Frontend build ---
# Baked into the bundle at build time, so the browser must be able to reach it.
# Change this together with BACKEND_PORT, then rebuild: docker compose build frontend
VITE_API_BASE_URL=http://localhost:9095
