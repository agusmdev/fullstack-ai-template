# Docker Compose configuration.
# Copy to .env for local overrides (git-ignored): cp .env.example .env
# Every value below already has a working default in docker-compose.yml.
# Keep values free of inline comments — Compose reads them literally.

# --- Service ports (change if they clash with something already running) ---
BACKEND_PORT=9095
FRONTEND_PORT=3000
DB_PORT=5432

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Backend runtime ---
APP_NAME=backend
ENVIRONMENT=local
DEBUG_MODE=false
DB_POOL_SIZE=100
DB_POOL_PRE_PING=false
LOG_LEVEL=INFO
# console (readable) or json (one wide event per request, for log shipping)
LOG_FORMAT=console
# CORS origin the backend accepts — keep in sync with FRONTEND_PORT.
FRONTEND_URL=http://localhost:3000

# --- Optional integrations (leave empty to turn them off) ---
# Sentry is also off when ENVIRONMENT=local.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Google OAuth. The redirect URI must match the one set in the Google console
# and the published BACKEND_PORT.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9095/auth/oauth/google/callback

# --- Optional log context (added to every log line when set) ---
VERSION=
COMMIT_HASH=
INSTANCE_ID=

# --- Frontend build ---
# Baked into the bundle at build time, so the browser must be able to reach it.
# Change this together with BACKEND_PORT, then rebuild: docker compose build frontend
VITE_API_BASE_URL=http://localhost:9095
